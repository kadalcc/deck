{
  "name": "kadal-deck-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '@kadal/deck' build && bun run --filter './packages/deck-*' build && bun run --filter @kadal/create-deck build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun run --filter './packages/*' test",
    "lint": "oxlint packages",
    "format": "oxfmt packages examples/starter",
    "changeset": "changeset",
    "release": "bun run build && node tools/publish.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "playwright": "1.61.1"
  }
}
