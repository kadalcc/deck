{
  "name": "@kadal/deck",
  "version": "0.4.6",
  "description": "Kadal Deck: presentations written in MDX, with a live room for the audience (polls, questions, reactions from their phones), islands in any framework, export to PDF, PNG and PPTX, and the kadal-deck CLI and MCP server.",
  "keywords": [
    "presentation",
    "slides",
    "mdx",
    "markdown",
    "deck",
    "slideshow",
    "presenter-view",
    "speaker-notes",
    "live-polling",
    "audience",
    "vite",
    "react",
    "pdf-export",
    "pptx",
    "mcp"
  ],
  "homepage": "https://deck.kadal.cc",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pmithunish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadalcc/deck.git",
    "directory": "packages/deck"
  },
  "bugs": {
    "url": "https://github.com/kadalcc/deck/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Kadal <hello@kadal.cc> (https://kadal.cc)",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/backgrounds/*.tsx",
    "./dist/backgrounds/*.js",
    "./dist/renderers/index.js"
  ],
  "files": [
    "dist",
    "schema",
    "template",
    "skill",
    "REFERENCE.md",
    "LICENSE",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "THEMES.md",
    "tools/verify-island.mjs"
  ],
  "bin": {
    "kadal-deck": "dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "import": "./dist/authoring/index.js"
    },
    "./import": {
      "types": "./dist/import/index.d.ts",
      "import": "./dist/import/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "import": "./dist/live/index.js"
    },
    "./protocol": {
      "types": "./dist/live/protocol.d.ts",
      "import": "./dist/live/protocol.js"
    },
    "./presenter": {
      "types": "./dist/presenter/index.d.ts",
      "import": "./dist/presenter/index.js"
    },
    "./audience": {
      "types": "./dist/audience/index.d.ts",
      "import": "./dist/audience/index.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js"
    },
    "./backgrounds": {
      "types": "./dist/backgrounds/index.d.ts",
      "import": "./dist/backgrounds/index.js"
    },
    "./renderers": {
      "types": "./dist/renderers/index.d.ts",
      "import": "./dist/renderers/index.js"
    },
    "./renderers/contract": {
      "types": "./dist/renderers/contract.d.ts",
      "import": "./dist/renderers/contract.js"
    },
    "./monaco": {
      "types": "./dist/monaco/index.d.ts",
      "import": "./dist/monaco/index.js"
    },
    "./sketch": {
      "types": "./dist/sketch/index.d.ts",
      "import": "./dist/sketch/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    },
    "./styles.css": "./dist/themes/base.css",
    "./themes/*": "./dist/themes/*",
    "./schema/frontmatter.json": "./schema/frontmatter.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsdown && node tools/sync-template.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "test": "bun test",
    "verify:island": "node tools/verify-island.mjs",
    "prepack": "tsdown && node tools/sync-template.mjs",
    "catalog": "bun tools/catalog.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@kadal/prettier-plugin": "^0.4.6",
    "@lezer/highlight": "^1.2.1",
    "@mdx-js/mdx": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@shikijs/monaco": "^3.23.0",
    "@shikijs/transformers": "^3.23.0",
    "@shikijs/twoslash": "^3.23.0",
    "dompurify": "^3.4.16",
    "hast-util-to-estree": "^3.1.3",
    "katex": "^0.16.22",
    "lucide-react": "^1.18.0",
    "mermaid": "^11.4.1",
    "modern-screenshot": "^4.7.0",
    "monaco-editor": "0.57.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^3.12.0",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.13.0",
    "shiki-magic-move": "^1.1.0",
    "sucrase": "^3.35.1",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-util-types": "^2.0.3",
    "playwright": "1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.0.0 || ^8.0.0",
    "playwright": "^1.50.0",
    "kokoro-js": "^1.2.1",
    "typescript": ">=5.5.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "kokoro-js": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
