{
  "name": "@kadal/theme-lecture",
  "version": "0.9.2",
  "description": "Lecture, a theme for Kadal Deck (@kadal/deck). An academic theme for lectures and seminars: numbered sections, a course footer, theorem, definition and proof blocks, citations, and print-perfect pages.",
  "keywords": [
    "kadal-theme",
    "kadal-deck",
    "presentation",
    "slides",
    "theme",
    "academic",
    "lecture",
    "education",
    "math"
  ],
  "homepage": "https://deck.kadal.cc/themes/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pmithunish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadalcc/deck.git",
    "directory": "packages/theme-lecture"
  },
  "bugs": {
    "url": "https://github.com/kadalcc/deck/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Kadal <hello@kadal.cc> (https://kadal.cc)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "style.css",
    "index.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.tsx",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "kadal": {
    "theme": {
      "name": "lecture",
      "title": "Lecture",
      "description": "An academic theme for lectures and seminars: numbered sections, a course footer, theorem, definition and proof blocks, citations, and print-perfect pages.",
      "colorScheme": "both",
      "swatch": [
        "#1f4e8c",
        "#a23b2a"
      ],
      "config": {
        "transition": "fade",
        "fonts": {
          "heading": "Source Serif 4",
          "sans": "Source Sans 3",
          "serif": "Source Serif 4",
          "mono": "Source Code Pro",
          "weights": "400,600,700",
          "italic": true
        }
      },
      "themeConfig": {
        "course": "",
        "author": "",
        "institution": "",
        "footer": true,
        "sectionNumbers": true
      },
      "shiki": {
        "light": "github-light",
        "dark": "github-dark-dimmed"
      },
      "defaults": {},
      "layouts": [
        "section",
        "definition",
        "theorem",
        "references"
      ],
      "components": [
        "Definition",
        "Theorem",
        "Lemma",
        "Corollary",
        "Proposition",
        "Proof",
        "Example",
        "Remark",
        "Cite"
      ]
    }
  },
  "scripts": {
    "dev": "kadal-deck dev -C preview",
    "check": "kadal-deck check -C preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@kadal/deck": "^0.9.2",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@kadal/deck": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
