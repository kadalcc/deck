{
  "name": "@kadal/theme-neon",
  "version": "0.7.0",
  "description": "Neon, a theme for Kadal Deck (@kadal/deck). A dark synthwave theme for meetups and launches: a sunset horizon, glows that stay legible, and a solid print fallback.",
  "keywords": [
    "kadal-theme",
    "kadal-deck",
    "presentation",
    "slides",
    "theme",
    "synthwave",
    "neon",
    "dark",
    "launch"
  ],
  "homepage": "https://deck.kadal.cc/themes/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pmithunish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadalcc/deck.git",
    "directory": "packages/theme-neon"
  },
  "bugs": {
    "url": "https://github.com/kadalcc/deck/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Kadal <hello@kadal.cc> (https://kadal.cc)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "style.css",
    "index.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.tsx",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "kadal": {
    "theme": {
      "name": "neon",
      "title": "Neon",
      "description": "A dark synthwave theme for meetups and launches: a sunset horizon, glows that stay legible, and a solid print fallback.",
      "colorScheme": "dark",
      "swatch": [
        "#ff3ec8",
        "#2de2e6"
      ],
      "config": {
        "transition": "fade",
        "fonts": {
          "heading": "Orbitron",
          "sans": "Space Grotesk",
          "mono": "JetBrains Mono",
          "weights": "400,500,700"
        }
      },
      "themeConfig": {
        "primary": "#ff3ec8",
        "secondary": "#2de2e6",
        "grid": true
      },
      "shiki": {
        "light": "synthwave-84",
        "dark": "synthwave-84"
      },
      "defaults": {},
      "layouts": [
        "launch",
        "horizon"
      ],
      "components": [
        "Glow"
      ]
    }
  },
  "scripts": {
    "dev": "kadal-deck dev -C preview",
    "check": "kadal-deck check -C preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@kadal/deck": "^0.7.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@kadal/deck": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
