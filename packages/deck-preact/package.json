{
  "name": "@kadal/deck-preact",
  "version": "0.1.0",
  "description": "The Preact renderer for Kadal Deck (@kadal/deck): Preact components as islands on a slide.",
  "keywords": [
    "kadal-deck",
    "presentation",
    "slides",
    "islands",
    "preact"
  ],
  "homepage": "https://deck.kadal.cc/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmithunish/kadal-deck.git",
    "directory": "packages/deck-preact"
  },
  "bugs": {
    "url": "https://github.com/pmithunish/kadal-deck/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Mithunish Prabhakaran <pmithunish@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "bun test",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@kadal/deck": "workspace:*",
    "preact": "^11.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@kadal/deck": "^0.1.0",
    "preact": "^10.0.0 || ^11.0.0"
  }
}
