{
  "name": "@kadal/theme-swiss",
  "version": "0.4.3",
  "description": "Swiss, a theme for Kadal Deck (@kadal/deck). A bold International-style theme for design talks: huge grotesk headings on a strict twelve-column grid, one signal colour.",
  "keywords": [
    "kadal-theme",
    "kadal-deck",
    "presentation",
    "slides",
    "theme",
    "swiss",
    "grid",
    "design",
    "grotesk"
  ],
  "homepage": "https://deck.kadal.cc/themes/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pmithunish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadalcc/deck.git",
    "directory": "packages/theme-swiss"
  },
  "bugs": {
    "url": "https://github.com/kadalcc/deck/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Kadal <hello@kadal.cc> (https://kadal.cc)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "style.css",
    "index.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.tsx",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "kadal": {
    "theme": {
      "name": "swiss",
      "title": "Swiss",
      "description": "A bold International-style theme for design talks: huge grotesk headings on a strict twelve-column grid, one signal colour.",
      "colorScheme": "both",
      "config": {
        "transition": "fade",
        "fonts": {
          "heading": "Inter Tight",
          "sans": "Inter",
          "mono": "JetBrains Mono",
          "weights": "400,500,700,800"
        }
      },
      "themeConfig": {
        "header": true
      },
      "shiki": {
        "light": "min-light",
        "dark": "vesper"
      },
      "defaults": {},
      "layouts": [
        "poster",
        "index",
        "grid"
      ],
      "components": [
        "Rule"
      ]
    }
  },
  "scripts": {
    "dev": "kadal-deck dev -C preview",
    "check": "kadal-deck check -C preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@kadal/deck": "^0.4.3",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@kadal/deck": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
