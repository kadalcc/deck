{
  "name": "@kadal/deck-angular",
  "version": "0.1.0",
  "description": "The Angular renderer for Kadal Deck (@kadal/deck): Angular standalone components as islands on a slide.",
  "keywords": [
    "kadal-deck",
    "presentation",
    "slides",
    "islands",
    "angular"
  ],
  "homepage": "https://deck.kadal.cc/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadalcc/deck.git",
    "directory": "packages/deck-angular"
  },
  "bugs": {
    "url": "https://github.com/kadalcc/deck/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Mithunish Prabhakaran <pmithunish@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "bun test",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@kadal/deck": "workspace:*",
    "typescript": "^6.0.3",
    "@angular/compiler": "^22.2.1"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/platform-browser": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@kadal/deck": "^0.1.0",
    "@angular/compiler": "^20.0.0 || ^21.0.0 || ^22.0.0"
  }
}
