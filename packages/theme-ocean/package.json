{
  "name": "@kadal/theme-ocean",
  "version": "0.8.0",
  "description": "Ocean, a theme for Kadal Deck (@kadal/deck). Kadal's own theme: the sea's palette from sunlit shallows to midnight water, calm gradients and polished type.",
  "keywords": [
    "kadal-theme",
    "kadal-deck",
    "presentation",
    "slides",
    "theme",
    "ocean",
    "sea",
    "kadal",
    "gradient"
  ],
  "homepage": "https://deck.kadal.cc/themes/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pmithunish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadalcc/deck.git",
    "directory": "packages/theme-ocean"
  },
  "bugs": {
    "url": "https://github.com/kadalcc/deck/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Kadal <hello@kadal.cc> (https://kadal.cc)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "style.css",
    "index.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.tsx",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "kadal": {
    "theme": {
      "name": "ocean",
      "title": "Ocean",
      "description": "Kadal's own theme: the sea's palette from sunlit shallows to midnight water, calm gradients and polished type.",
      "colorScheme": "both",
      "swatch": [
        "#1d63a8",
        "#13908e"
      ],
      "config": {
        "transition": "fade",
        "fonts": {
          "sans": "Catamaran",
          "mono": "JetBrains Mono",
          "weights": "400,500,600,700,800"
        }
      },
      "themeConfig": {
        "waves": true
      },
      "shiki": {
        "light": "night-owl-light",
        "dark": "night-owl"
      },
      "defaults": {},
      "layouts": [
        "waves",
        "depth"
      ],
      "components": [
        "Wave"
      ]
    }
  },
  "scripts": {
    "dev": "kadal-deck dev -C preview",
    "check": "kadal-deck check -C preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@kadal/deck": "^0.8.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@kadal/deck": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
