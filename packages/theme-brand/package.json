{
  "name": "@kadal/theme-brand",
  "version": "0.6.2",
  "description": "Brand, a theme for Kadal Deck (@kadal/deck). A corporate theme a company brands without CSS: primary and secondary colours, a logo and a footer line, all from themeConfig, on a clean and trustworthy layout.",
  "keywords": [
    "kadal-theme",
    "kadal-deck",
    "presentation",
    "slides",
    "theme",
    "corporate",
    "brand",
    "business",
    "company"
  ],
  "homepage": "https://deck.kadal.cc/themes/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pmithunish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadalcc/deck.git",
    "directory": "packages/theme-brand"
  },
  "bugs": {
    "url": "https://github.com/kadalcc/deck/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Kadal <hello@kadal.cc> (https://kadal.cc)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "style.css",
    "index.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.tsx",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "kadal": {
    "theme": {
      "name": "brand",
      "title": "Brand",
      "description": "A corporate theme a company brands without CSS: primary and secondary colours, a logo and a footer line, all from themeConfig, on a clean and trustworthy layout.",
      "colorScheme": "both",
      "swatch": [
        "#2453d4",
        "#0f9d8a"
      ],
      "config": {
        "transition": "slide",
        "fonts": {
          "sans": "Plus Jakarta Sans",
          "mono": "JetBrains Mono",
          "weights": "400,500,600,700,800"
        }
      },
      "themeConfig": {
        "primary": "#2453d4",
        "secondary": "#0f9d8a",
        "primaryInk": "#ffffff",
        "logo": "",
        "logoDark": "",
        "company": "",
        "footer": "",
        "logoPosition": "top-right"
      },
      "shiki": {
        "light": "github-light-default",
        "dark": "github-dark-default"
      },
      "defaults": {},
      "layouts": [
        "title-logo",
        "agenda",
        "metrics"
      ],
      "components": [
        "Metric",
        "Logo"
      ]
    }
  },
  "scripts": {
    "dev": "kadal-deck dev -C preview",
    "check": "kadal-deck check -C preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@kadal/deck": "^0.6.2",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@kadal/deck": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
