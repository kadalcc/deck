{
  "name": "@kadal/theme-shibainu",
  "version": "0.9.1",
  "description": "Shibainu: Slidev's shibainu theme, ported to Kadal Deck. Soft blobs in a shiba's browns, Titillium Web, fourteen layouts; dark.",
  "keywords": [
    "kadal-theme",
    "kadal-deck",
    "presentation",
    "slides",
    "theme",
    "slidev-port"
  ],
  "homepage": "https://deck.kadal.cc/themes/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadalcc/deck.git",
    "directory": "packages/theme-shibainu"
  },
  "bugs": {
    "url": "https://github.com/kadalcc/deck/issues"
  },
  "license": "MIT",
  "author": "Kadal <hello@kadal.cc> (https://kadal.cc)",
  "type": "module",
  "files": [
    "style.css",
    "index.tsx",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.tsx",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "kadal": {
    "theme": {
      "name": "shibainu",
      "title": "Shibainu",
      "description": "Soft blobs in a shiba's browns: Titillium Web, a different arrangement for each of fourteen layouts.",
      "colorScheme": "dark",
      "swatch": [
        "#bf926b",
        "#8c6645"
      ],
      "themeConfig": {
        "primary": "#402312"
      },
      "config": {
        "fonts": {
          "sans": "Titillium Web",
          "mono": "Fira Code",
          "weights": "300,400,600,700"
        }
      },
      "shiki": {
        "light": "vitesse-dark",
        "dark": "vitesse-dark"
      },
      "defaults": {},
      "layouts": [
        "default-2",
        "default-3",
        "default-4",
        "default-5",
        "default-6",
        "default-7",
        "right",
        "section-2",
        "section-3"
      ],
      "components": []
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "kadal-deck dev -C preview",
    "build": "kadal-deck build -C preview",
    "check": "kadal-deck check -C preview",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@kadal/deck": "^0.9.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@kadal/deck": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
